  {
   "id": "nif",
   "name": "DQ failed?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    1640,
    300
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ ($json.dq?.fails ?? []).length }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "nerr",
   "name": "Alert: DQ failed",
   "type": "n8n-nodes-base.stopAndError",
   "typeVersion": 1,
   "position": [
    1860,
    220
   ],
   "parameters": {
    "errorMessage": "={{ 'DQ failed: ' + $json.dq.fails.join(', ') + ' (run ' + $json.run_id + ')' }}"
   }
  },
  {
   "id": "n00",
   "name": "Daily 10:00 (+hourly catch-up)",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    300
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 10-22 * * *"
      }
     ]
    }
   }
  },
  {
   "id": "ngate",
   "name": "Run needed?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    400,
    300
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "g1",
       "leftValue": "={{ $json.skip }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "false",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
